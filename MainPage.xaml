<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FinanceTrackerApp"
             x:Class="FinanceTrackerApp.MainPage"
             Title="Финансовый трекер">
    
    <ContentPage.Resources>
        <local:TypeToEmojiConverter x:Key="TypeToEmojiConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Блок с балансом -->
        <Border Grid.Row="0"
                BackgroundColor="#2196F3"
                Padding="20"
                Margin="0,0,0,10">
            <VerticalStackLayout>
                <Label Text="Текущий баланс"
                       TextColor="White"
                       FontSize="14"
                       HorizontalOptions="Center" />
                <Label x:Name="BalanceLabel"
                       Text="0 ₽"
                       TextColor="White"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- Кнопка добавления -->
        <Button Grid.Row="1"
                Text="➕ Добавить операцию"
                BackgroundColor="#4CAF50"
                TextColor="White"
                CornerRadius="10"
                Margin="10"
                Clicked="OnAddClicked" />

        <!-- Список операций -->
        <CollectionView Grid.Row="2"
                        x:Name="TransactionsCollectionView"
                        Margin="0,10,0,0">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10"
                        ColumnDefinitions="Auto, *, Auto, Auto"
                        RowDefinitions="Auto, Auto">

                        <!-- Жест нажатия для редактирования -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="{Binding .}"
                                  Tapped="OnTransactionTapped" />
                        </Grid.GestureRecognizers>

                        <!-- Иконка -->
                        <Label Grid.Row="0"
                               Grid.RowSpan="2"
                               Grid.Column="0"
                               Text="{Binding Type, Converter={StaticResource TypeToEmojiConverter}}"
                               FontSize="30"
                               VerticalTextAlignment="Center"
                               Margin="0,0,15,0" />

                        <!-- Категория -->
                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding Category}"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <!-- Дата -->
                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}"
                               FontSize="12"
                               TextColor="Gray" />

                        <!-- Сумма -->
                        <Label Grid.Row="0"
                               Grid.RowSpan="2"
                               Grid.Column="2"
                               Text="{Binding Amount, StringFormat='{0:F2} ₽'}"
                               FontSize="16"
                               FontAttributes="Bold"
                               VerticalTextAlignment="Center">
                            <Label.Style>
                                <Style TargetType="Label">
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Label"
                                                 Binding="{Binding Type}"
                                                 Value="Income">
                                            <Setter Property="TextColor" Value="#4CAF50" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                 Binding="{Binding Type}"
                                                 Value="Expense">
                                            <Setter Property="TextColor" Value="#FF5722" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>

                        <!-- Кнопка удаления -->
                        <Button Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="3"
                                Text="🗑"
                                BackgroundColor="#FF5722"
                                TextColor="White"
                                CornerRadius="5"
                                WidthRequest="50"
                                HeightRequest="40"
                                VerticalOptions="Center"
                                Margin="10,0,0,0"
                                CommandParameter="{Binding .}"
                                Clicked="OnDeleteClicked" />

                        <!-- Разделитель -->
                        <BoxView Grid.Row="2"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="4"
                                 HeightRequest="1"
                                 Color="LightGray"
                                 Margin="0,10,0,0" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Что показывать, если список пуст -->
            <CollectionView.EmptyView>
                <StackLayout Padding="50">
                    <Label Text="📭 Нет операций"
                           FontSize="18"
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                    <Label Text="Нажмите 'Добавить операцию'"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                </StackLayout>
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>
</ContentPage>